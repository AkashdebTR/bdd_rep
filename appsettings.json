{
  "BaseUrl": "https://www.saucedemo.com/",
  "Browser": {
    "Engine": "chromium",
    "Channel": "chrome",
    "Headless": false
  },
  "Timeouts": {
    "ActionMs": 10000,
    "AssertionMs": 5000,
    "NavigationMs": 30000
  },
  "Diagnostics": {
    "CaptureScreenshotOnFailure": true,
    "TraceMode": "retain-on-failure",
    "ArtifactDirectory": "TestResults/artifacts",
    "ScreenshotDirectory": "TestResults/artifacts/screenshots",
    "TraceDirectory": "TestResults/artifacts/traces"
  },
  "Reporting": {
    "OutputDirectory": "TestResults/Reports"
  },
  "Retry": {
    "Enabled": false,
    "MaxRetries": 1,
    "CaptureScreenshotOnEveryFailedAttempt": true,
    "TraceOnRetry": true
  }
}